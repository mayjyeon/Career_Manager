rules_version = '2';

/**
 * 진로상담 관리 — Firestore 보안 규칙
 *
 * 모든 데이터는 users/{uid} 아래에만 저장하며,
 * 로그인한 본인만 자기 데이터를 읽고 쓸 수 있습니다.
 * 그 밖의 모든 경로는 기본 거부됩니다.
 *
 * 적용:
 *   firebase deploy --only firestore:rules
 *   (또는 Firebase Console → Firestore Database → 규칙 에 붙여넣기)
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isKnownCollection(name) {
      return name in ['students', 'schoolYears', 'sessions'];
    }

    // 학생 · 학년도 소속 · 상담 기록
    match /users/{userId}/{collectionName}/{docId} {
      allow read: if isOwner(userId) && isKnownCollection(collectionName);
      allow create, update: if isOwner(userId)
        && isKnownCollection(collectionName)
        && request.resource.data.keys().size() <= 20;
      allow delete: if isOwner(userId) && isKnownCollection(collectionName);
    }
  }
}
