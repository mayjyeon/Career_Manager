rules_version = '2';

/**
 * 진로상담 관리 — Firestore 보안 규칙
 *
 * 두 종류의 자료가 있습니다.
 *
 *   users/{uid}/…   학생 명부와 상담 기록. 선생님 계정 안에만 있고 본인만 읽고 씁니다.
 *   그 밖의 컬렉션   공지·과제·제출물·포트폴리오. 선생님과 학생이 함께 봅니다.
 *
 * 학생은 한 명당 문서 하나가 아니라 한 반이 문서 하나(classes)입니다.
 * Firestore 는 리스너로 배달된 문서마다 읽기를 매기므로, 900명을 낱개 문서로 두면
 * 명렬표 한 번 올릴 때 읽기·쓰기가 각각 수천 건씩 나옵니다.
 *
 * 선생님은 아래 이메일로 로그인한 계정 하나뿐입니다.
 * 이 값을 바꿀 때는 assets/js/roles.js 의 TEACHER_EMAIL 도 함께 고쳐야 합니다.
 *
 * 적용:
 *   firebase deploy --only firestore:rules
 *   (또는 Firebase Console → Firestore Database → 규칙 에 붙여넣기)
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn() && request.auth.token.email == 'mayjyeon52@gmail.com';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isKnownCollection(name) {
      return name in ['classes', 'sessions'];
    }

    /**
     * 이전 형식으로 남아 있는 컬렉션.
     * 학생 관리 화면의 ‘옛 문서 정리’ 로 지울 수 있게 읽기와 삭제만 열어 둡니다.
     * 정리를 마쳤으면 아래 match 블록을 통째로 지워도 됩니다.
     */
    function isLegacyCollection(name) {
      return name in ['students', 'schoolYears'];
    }

    /* ---------------------------------------------------------
       학생 명부 · 상담 기록 — 선생님 계정 안에만 있습니다.

       classes 문서 하나에 한 반 학생이 배열로 들어 있어
       최상위 필드는 다섯 개(schoolYear·grade·classNo·students·updatedAt)뿐입니다.
       --------------------------------------------------------- */
    match /users/{userId}/{collectionName}/{docId} {
      allow read: if isOwner(userId)
        && (isKnownCollection(collectionName) || isLegacyCollection(collectionName));
      allow create, update: if isOwner(userId)
        && isKnownCollection(collectionName)
        && request.resource.data.keys().size() <= 20;
      allow delete: if isOwner(userId)
        && (isKnownCollection(collectionName) || isLegacyCollection(collectionName));
    }

    /* ---------------------------------------------------------
       학생 정보 — 학생이 스스로 등록하고, 선생님은 전부 봅니다.
       문서 번호는 계정 번호(uid)와 같습니다.
       --------------------------------------------------------- */
    match /profiles/{uid} {
      allow read: if isOwner(uid) || isTeacher();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.grade is int
        && request.resource.data.classNo is int
        && request.resource.data.studentNo is int;
      allow delete: if isOwner(uid) || isTeacher();
    }

    /* ---------------------------------------------------------
       공지사항 · 과제 — 선생님만 쓰고, 로그인한 사람은 모두 읽습니다.

       공개 대상(학년·반)은 화면에서 걸러 보여줄 뿐 비밀은 아닙니다.
       학생에게 보이면 안 되는 내용은 올리지 마세요.
       --------------------------------------------------------- */
    match /notices/{docId} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    match /assignments/{docId} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    /* ---------------------------------------------------------
       제출물 · 포트폴리오 — 낸 학생 본인과 선생님만 봅니다.
       다른 학생은 목록에서도 볼 수 없습니다.

       지울 때는 deletedAt 만 적어 휴지통으로 보내고,
       보관 기간이 지나면 그때 진짜로 지웁니다.
       선생님은 내용을 고칠 수는 없고 휴지통에 넣고 빼는 것만 할 수 있습니다.
       --------------------------------------------------------- */
    function onlyChangesTrashFlag() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt']);
    }

    match /submissions/{docId} {
      allow read: if isTeacher() || isOwner(resource.data.studentUid);
      allow create: if isOwner(request.resource.data.studentUid)
        && request.resource.data.assignmentId is string;
      allow update: if (isOwner(resource.data.studentUid)
          && request.resource.data.studentUid == resource.data.studentUid)
        || (isTeacher() && onlyChangesTrashFlag());
      allow delete: if isOwner(resource.data.studentUid) || isTeacher();
    }

    match /portfolios/{docId} {
      allow read: if isTeacher() || isOwner(resource.data.studentUid);
      allow create: if isOwner(request.resource.data.studentUid);
      allow update: if (isOwner(resource.data.studentUid)
          && request.resource.data.studentUid == resource.data.studentUid)
        || (isTeacher() && onlyChangesTrashFlag());
      allow delete: if isOwner(resource.data.studentUid) || isTeacher();
    }
  }
}
